<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LocalFM.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Palette. Accent is overridden later by cover-art theming. -->
    <Color x:Key="AccentColor">#E0567A</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <!-- Fluent's own accent (sliders, toggles, focus) follows ours. -->
    <Color x:Key="SystemAccentColor">#E0567A</Color>
    <Color x:Key="SystemAccentColorLight1">#E8708F</Color>
    <Color x:Key="SystemAccentColorLight2">#EE8BA4</Color>
    <Color x:Key="SystemAccentColorLight3">#F4A7BA</Color>
    <Color x:Key="SystemAccentColorDark1">#C84567</Color>
    <Color x:Key="SystemAccentColorDark2">#A93856</Color>
    <Color x:Key="SystemAccentColorDark3">#8A2C46</Color>
    <SolidColorBrush x:Key="Bg" Color="#111114" />
    <SolidColorBrush x:Key="Surface" Color="#18181C" />
    <SolidColorBrush x:Key="Surface2" Color="#222228" />
    <SolidColorBrush x:Key="Surface3" Color="#2C2C34" />
    <SolidColorBrush x:Key="Line" Color="#2A2A31" />
    <SolidColorBrush x:Key="Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="Muted" Color="#9A9AA6" />
    <SolidColorBrush x:Key="Faint" Color="#6A6A75" />

    <!-- Icons: 24x24 grid. Filled ones use Fill, the rest are strokes (see Path.icon style). -->
    <StreamGeometry x:Key="IcoPlay">M8 5.5v13l10.5-6.5z</StreamGeometry>
    <StreamGeometry x:Key="IcoPause">M7 5h3.5v14H7zM13.5 5H17v14h-3.5z</StreamGeometry>
    <StreamGeometry x:Key="IcoNext">M5 6l9 6-9 6zM16 6h2.5v12H16z</StreamGeometry>
    <StreamGeometry x:Key="IcoPrev">M19 6l-9 6 9 6zM5.5 6H8v12H5.5z</StreamGeometry>
    <StreamGeometry x:Key="IcoShuffle">M3 7h3.5c2 0 3 1 4.5 3.5l2 3c1.5 2.5 2.5 3.5 4.5 3.5H21M3 17h3.5c1.2 0 2-.4 2.8-1.3M14.7 8.3c.8-.9 1.6-1.3 2.8-1.3H21M18 4l3 3-3 3M18 14l3 3-3 3</StreamGeometry>
    <StreamGeometry x:Key="IcoRepeat">M4 11V9.5A3.5 3.5 0 0 1 7.5 6H20M17 3l3 3-3 3M20 13v1.5a3.5 3.5 0 0 1-3.5 3.5H4M7 21l-3-3 3-3</StreamGeometry>
    <StreamGeometry x:Key="IcoVolume">M4 9.5h3.5L12 6v12l-4.5-3.5H4zM15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11</StreamGeometry>
    <StreamGeometry x:Key="IcoAlbum">M12 3a9 9 0 1 1 0 18 9 9 0 1 1 0-18M12 10a2 2 0 1 1 0 4 2 2 0 1 1 0-4</StreamGeometry>
    <StreamGeometry x:Key="IcoArtist">M12 4a4 4 0 1 1 0 8 4 4 0 1 1 0-8M4.5 20c.5-3.5 3.5-5.5 7.5-5.5s7 2 7.5 5.5</StreamGeometry>
    <StreamGeometry x:Key="IcoTracks">M9 17.5V5.5l11-2v12M9 17.5a3 3 0 1 1-6 0 3 3 0 1 1 6 0M20 15.5a3 3 0 1 1-6 0 3 3 0 1 1 6 0</StreamGeometry>
    <StreamGeometry x:Key="IcoPlaylist">M3.5 6h12M3.5 11h12M3.5 16h7M18 9v8.5M18 17.5a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 1 1 4.4 0M18 9l3-1</StreamGeometry>
    <StreamGeometry x:Key="IcoQueue">M4 6h16M4 11h16M4 16h10M17 15l3 2-3 2z</StreamGeometry>
    <StreamGeometry x:Key="IcoFolder">M3.5 6.5a1 1 0 0 1 1-1h4.5l2 2h8.5a1 1 0 0 1 1 1V17.5a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1z</StreamGeometry>
    <StreamGeometry x:Key="IcoPlus">M12 5v14M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IcoTrash">M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 12.5h9l1-12.5</StreamGeometry>
    <StreamGeometry x:Key="IcoUp">M6 15l6-6 6 6</StreamGeometry>
    <StreamGeometry x:Key="IcoDown">M6 9l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IcoSearch">M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 1 1 0-13M15.5 15.5l5 5</StreamGeometry>
    <StreamGeometry x:Key="IcoBack">M15 5l-7 7 7 7</StreamGeometry>
    <StreamGeometry x:Key="IcoRefresh">M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4v4.5H15</StreamGeometry>
    <StreamGeometry x:Key="IcoPlayNext">M4 6h11M4 11h11M4 16h6M14 14.5v6l5-3z</StreamGeometry>
    <StreamGeometry x:Key="IcoSave">M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6</StreamGeometry>
    <StreamGeometry x:Key="IcoLyrics">M4.5 5.5h15v10h-9l-4.5 4v-4h-1.5zM8 9h8M8 12h5</StreamGeometry>
    <StreamGeometry x:Key="IcoMagic">M5 19L15.5 8.5M14 4.5v3M12.5 6h3M19 9.5v3M17.5 11h3M8.5 3.5v2M7.5 4.5h2M15.5 8.5l1 1</StreamGeometry>
    <StreamGeometry x:Key="IcoEdit">M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4</StreamGeometry>
    <StreamGeometry x:Key="IcoLock">M6.5 11h11v9h-11zM8.5 11V8a3.5 3.5 0 0 1 7 0v3</StreamGeometry>
    <StreamGeometry x:Key="IcoUnlock">M6.5 11h11v9h-11zM8.5 11V8a3.5 3.5 0 0 1 6.8-1.2</StreamGeometry>
    <StreamGeometry x:Key="IcoSliders">M6 4v5M6 13v7M12 4v9M12 17v3M18 4v3M18 11v9M4 11h4M10 15h4M16 9h4</StreamGeometry>
    <StreamGeometry x:Key="IcoMini">M4 5h16v14H4zM12 12h6v5h-6z</StreamGeometry>
    <StreamGeometry x:Key="IcoExpand">M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7</StreamGeometry>
    <StreamGeometry x:Key="IcoStats">M4 20h16M6.5 20v-6M11 20V8M15.5 20v-9M20 20V4.5</StreamGeometry>
    <StreamGeometry x:Key="IcoWave">M3 12h2M7 8v8M11 4v16M15 7v10M19 10v4M21 12h0</StreamGeometry>
    <StreamGeometry x:Key="IcoNote">M9 18V6l10-2v12M9 18a3 3 0 1 1-6 0 3 3 0 1 1 6 0M19 16a3 3 0 1 1-6 0 3 3 0 1 1 6 0</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector=":is(Window)">
      <Setter Property="Background" Value="{StaticResource Bg}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
    <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="12" /></Style>

    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Path.fill">
      <Setter Property="Fill" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!-- Flat icon buttons -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.flat:pointerover"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
    <Style Selector="Button.flat:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:disabled"><Setter Property="Opacity" Value="0.35" /></Style>
    <Style Selector="Button.flat.on"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Button.flat.on:pointerover"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
    <Style Selector="Button.flat.on:pointerover /template/ ContentPresenter"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>

    <Style Selector="Button.play">
      <Setter Property="Background" Value="{StaticResource Text}" />
      <Setter Property="Foreground" Value="{StaticResource Bg}" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Bg}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Track rows -->
    <Style Selector="ListBox.rows">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>

    <!-- Editor -->
    <Style Selector="AutoCompleteBox.field">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="AutoCompleteBox.field /template/ TextBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style Selector="AutoCompleteBox.field.changed /template/ TextBox">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.lock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.lock:checked"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
    <Style Selector="ToggleButton.lock:checked /template/ ContentPresenter, ToggleButton.lock:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="ToggleButton.lock:checked /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.lock:checked:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Surface3}" /></Style>
    <Style Selector="ToggleButton.lock:checked /template/ ContentPresenter, ToggleButton.lock:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
    </Style>
    <Style Selector="Border.editrow.focused"><Setter Property="Background" Value="{StaticResource Surface2}" /></Style>

    <Style Selector="Slider.seek">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
  </Application.Styles>
</Application>
