<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LocalFM</AssemblyName>
    <RootNamespace>LocalFM.UI</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LocalFM.App\LocalFM.App.csproj" />
    <ProjectReference Include="..\LocalFM.Desktop\LocalFM.Desktop.csproj" />
    <ProjectReference Include="..\LocalFM.Ingest\LocalFM.Ingest.csproj" />
    <ProjectReference Include="..\LocalFM.Vibe\LocalFM.Vibe.csproj" />
  </ItemGroup>
</Project>
