<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             x:Class="LocalFM.UI.Views.TidyView"
             x:DataType="vm:TidyViewModel">
  <DockPanel Margin="24,0,24,0">
    <StackPanel DockPanel.Dock="Top" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Tidy up" />
      <TextBlock Classes="muted" TextWrapping="Wrap">
        Names that look damaged: video-channel artists ("Scorpions - Topic"), "(Official Video)", the artist repeated in the
        title, "+" instead of spaces, remaster notes. Nothing changes until you apply. Fields you locked are skipped, and
        MusicBrainz may still improve what is fixed here.
      </TextBlock>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Command="{Binding ApplySelectedCommand}">Apply selected</Button>
        <Button Classes="ghost" Command="{Binding SelectAllCommand}">Select all</Button>
        <Button Classes="ghost" Command="{Binding SelectNoneCommand}">Select none</Button>
        <Button Classes="ghost" Command="{Binding ScanCommand}">Look again</Button>
      </StackPanel>
      <TextBlock Text="{Binding Status}" Classes="muted small" />
    </StackPanel>
    <ListBox Classes="rows" ItemsSource="{Binding Suggestions}" Margin="-10,8,0,8">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SuggestionViewModel">
          <Grid ColumnDefinitions="Auto,64,*,28,*,1.1*">
            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
            <Border Grid.Column="1" CornerRadius="5" Background="{StaticResource Surface3}" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding Suggestion.Kind}" Classes="small" />
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding Suggestion.Current}" Classes="muted" TextDecorations="Strikethrough"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Suggestion.Current}" />
            <TextBlock Grid.Column="3" Text="→" Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Suggestion.Suggested}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="{Binding Suggestion.Reason}" Classes="small" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Suggestion.Context}" Classes="faint small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
