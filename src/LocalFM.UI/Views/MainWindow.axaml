<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalFM.UI.ViewModels"
        xmlns:v="using:LocalFM.UI.Views"
        x:Class="LocalFM.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="LocalFM" Width="1280" Height="820" MinWidth="820" MinHeight="520">
  <!-- The root panel also holds the invisible resize grips along the window edges (WindowChrome) -->
  <Border x:Name="Frame">
    <Panel x:Name="RootPanel">
      <v:MainView x:Name="View" />
    </Panel>
  </Border>
</Window>
