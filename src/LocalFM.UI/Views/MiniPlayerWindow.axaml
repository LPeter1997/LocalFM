<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalFM.UI.ViewModels"
        xmlns:c="using:LocalFM.UI.Controls"
        x:Class="LocalFM.UI.Views.MiniPlayerWindow"
        x:DataType="vm:NowPlayingViewModel"
        Title="LocalFM" Width="460" Height="124" CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
  <!-- No system title bar: drag anywhere to move, double-click (or the expand button) for the full window -->
  <Border x:Name="Root" Background="{StaticResource Bg}" Padding="12">
  <Panel>
  <!-- The chosen visualizer, faded behind everything (out to the window edges, under the padding) -->
  <c:Visualizer x:Name="Backdrop" Margin="-12" Opacity="0.25" IsHitTestVisible="False" BarBrush="{StaticResource Accent}" Bands="48" />
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Width="88" Height="88" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Surface3}"
            VerticalAlignment="Top">
      <Panel>
        <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="28" Height="28" Stroke="{StaticResource Faint}" />
        <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="176" />
      </Panel>
    </Border>
    <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Row="1" Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Grid.RowSpan="2" Classes="flat" x:Name="ExpandButton" ToolTip.Tip="Back to the full window"
              VerticalAlignment="Top" Margin="6,-4,-4,0">
        <c:Icon Classes="icon" Data="{StaticResource IcoExpand}" />
      </Button>
      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" VerticalAlignment="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="flat" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
          <c:Icon Classes="icon fill" Data="{StaticResource IcoPrev}" />
        </Button>
        <Button Classes="play" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play/Pause (Space)">
          <Panel>
            <c:Icon Classes="icon fill" Data="{StaticResource IcoPlay}" Width="20" Height="20" Margin="3,0,0,0" IsVisible="{Binding !IsPlaying}" />
            <c:Icon Classes="icon fill" Data="{StaticResource IcoPause}" Width="18" Height="18" IsVisible="{Binding IsPlaying}" />
          </Panel>
        </Button>
        <Button Classes="flat" Command="{Binding NextCommand}" ToolTip.Tip="Next">
          <c:Icon Classes="icon fill" Data="{StaticResource IcoNext}" />
        </Button>
        <TextBlock VerticalAlignment="Center" Classes="faint small" Margin="6,0,0,0">
          <Run Text="{Binding PositionText}" /><Run Text=" / " /><Run Text="{Binding DurationText}" />
        </TextBlock>
      </StackPanel>
      <!-- Volume: same mute button and slider as the player bar; scrolling anywhere also changes it -->
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="8,0,0,0" VerticalAlignment="Center">
        <Button Classes="flat" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (scroll to change volume)">
          <Panel>
            <c:Icon Classes="icon" Data="{StaticResource IcoVolume}" IsVisible="{Binding !Muted}" />
            <c:Icon Classes="icon" Data="{StaticResource IcoVolumeMute}" IsVisible="{Binding Muted}" />
          </Panel>
        </Button>
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" Classes="seek" VerticalAlignment="Center" />
      </Grid>
      </Grid>
    </Grid>
    <ProgressBar Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" Height="3" MinHeight="3" Minimum="0"
                 Maximum="{Binding Duration}" Value="{Binding Position}" Foreground="{StaticResource Accent}"
                 Background="{StaticResource Surface3}" />
  </Grid>
  </Panel>
  </Border>
</Window>
