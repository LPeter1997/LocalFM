<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             x:Class="LocalFM.UI.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">
  <StackPanel Margin="24,0,24,12" Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
    <TextBlock Classes="h1" Text="Sources" />
    <TextBlock Classes="muted" TextWrapping="Wrap">
      Folders LocalFM scans for music. They are watched for changes; moved or renamed files keep their
      metadata and play history because files are identified by their audio content, not their path.
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="primary" Command="{Binding AddFolderCommand}">Add folder…</Button>
      <Button Classes="ghost" Command="{Binding RescanAllCommand}">Rescan all</Button>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="lib:Source">
          <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Classes="icon" Data="{StaticResource IcoFolder}" Stroke="{StaticResource Muted}" />
              <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="flat" ToolTip.Tip="Remove source (its tracks are kept as missing)"
                      Command="{Binding $parent[UserControl].((vm:SourcesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                <Path Classes="icon" Data="{StaticResource IcoTrash}" Width="16" Height="16" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="h2" Text="Online metadata" Margin="0,14,0,0" />
    <TextBlock Classes="muted" TextWrapping="Wrap">
      LocalFM works fully offline. When allowed, it asks free services (MusicBrainz, Cover Art Archive, iTunes, LRCLIB)
      about your music: album and track details, covers and lyrics. Answers are stored locally, so each question is asked once.
    </TextBlock>
    <CheckBox IsChecked="{Binding OnlineEnabled}">Use online services</CheckBox>
    <CheckBox IsChecked="{Binding AutoFetchLyrics}" IsEnabled="{Binding OnlineEnabled}">Look up lyrics automatically when a track starts</CheckBox>
    <TextBlock Classes="faint small"><Run Text="Library data: " /><Run Text="{Binding DataFolder}" /></TextBlock>
  </StackPanel>
</UserControl>
