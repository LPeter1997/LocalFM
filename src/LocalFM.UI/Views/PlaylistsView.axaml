<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             x:Class="LocalFM.UI.Views.PlaylistsView"
             x:DataType="vm:PlaylistsViewModel">
  <Grid ColumnDefinitions="260,*">
    <DockPanel Margin="24,0,8,12">
      <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Playlists" Margin="0,0,0,12" />
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBox Text="{Binding NewName}" PlaceholderText="New playlist name">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="flat" Command="{Binding CreateCommand}" ToolTip.Tip="Create playlist" Margin="4,0,0,0">
          <c:Icon Classes="icon" Data="{StaticResource IcoPlus}" />
        </Button>
      </Grid>
      <ListBox Classes="nav" ItemsSource="{Binding Playlists}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lib:PlaylistSummary">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="faint small" Text="{Binding EntryCount, Converter={x:Static ui:Converters.Tracks}}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="flat" Padding="4" ToolTip.Tip="Delete playlist"
                      Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                <c:Icon Classes="icon" Data="{StaticResource IcoTrash}" Width="14" Height="14" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="360"
                IsVisible="{Binding Playlists.Count, Converter={x:Static ui:Converters.IsZero}}">
      <c:Icon Classes="icon" Data="{StaticResource IcoPlaylist}" Width="40" Height="40" Stroke="{StaticResource Faint}" HorizontalAlignment="Center" />
      <TextBlock Classes="h2" Text="No playlists yet" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                 Text="Name one on the left, save the queue from the Queue page, or right-click any track and add it to a playlist." />
    </StackPanel>
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="16,0,24,12"
                  IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="h2" Text="{Binding Selected.Name}" VerticalAlignment="Center" />
        <Button Classes="primary" Command="{Binding PlayAllCommand}">Play</Button>
      </StackPanel>
      <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Tracks}" Margin="8,0,16,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lib:TrackInfo">
          <Grid ColumnDefinitions="44,2*,1.4*,64">
            <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
              <Panel>
                  <!-- No cover: the same faint note as the player bar -->
                  <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="16" Height="16" Stroke="{StaticResource Faint}" StrokeThickness="1.4" />
                  <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="72" />
                </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Album}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Text="{Binding DurationMs, Converter={x:Static ui:Converters.Duration}}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
