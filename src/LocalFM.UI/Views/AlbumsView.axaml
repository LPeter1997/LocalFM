<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:enrich="using:LocalFM.Library.Enrich"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             x:Class="LocalFM.UI.Views.AlbumsView"
             x:DataType="vm:AlbumsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="24,0,24,12">
      <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
      <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,6,0,0" />
      <Button Classes="primary" Command="{Binding PlayAllCommand}" IsVisible="{Binding IsArtistPage}" VerticalAlignment="Center">Play all</Button>
    </StackPanel>
    <Panel>
      <ScrollViewer>
        <StackPanel>
        <!-- Artist profile (artist pages only) -->
        <Grid ColumnDefinitions="Auto,*" Margin="24,4,24,18" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
              DataContext="{Binding Profile}" x:DataType="vm:ArtistProfileViewModel">
          <Border Width="150" Height="150" CornerRadius="75" ClipToBounds="True" Background="{StaticResource Surface3}" VerticalAlignment="Top">
            <Panel>
              <Path Classes="icon" Data="{StaticResource IcoArtist}" Width="52" Height="52" Stroke="{StaticResource Faint}" StrokeThickness="1.2" />
              <c:CoverImage Path="{Binding PhotoPath}" DecodeWidth="300" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Facts}" FontWeight="Medium" IsVisible="{Binding Facts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding Description}" Classes="muted small" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Genres}" IsVisible="{Binding HasGenres}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                    <TextBlock Text="{Binding}" Classes="small muted" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="4" IsVisible="{Binding HasBio}">
              <TextBlock Text="{Binding Bio}" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Text}"
                         MaxLines="4" TextTrimming="WordEllipsis" IsVisible="{Binding !BioExpanded}" />
              <TextBlock Text="{Binding Bio}" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Text}" IsVisible="{Binding BioExpanded}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="link" Command="{Binding ToggleBioCommand}">
                  <Panel>
                    <TextBlock Text="Show more" IsVisible="{Binding !BioExpanded}" />
                    <TextBlock Text="Show less" IsVisible="{Binding BioExpanded}" />
                  </Panel>
                </Button>
                <Button Classes="link" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding BioUrl}" Content="{Binding BioSource}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasMembers}">
              <TextBlock Text="Members" Classes="small faint" />
              <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemberRow">
                    <Button Classes="chip" Classes.former="{Binding Former}" Classes.local="{Binding InLibrary}"
                            Command="{Binding $parent[ItemsControl].((vm:ArtistProfileViewModel)DataContext).OpenMemberCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Detail}">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Text="{Binding Detail}" Classes="small faint" IsVisible="{Binding HasDetail}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="link" Command="{Binding ToggleFormerCommand}" Content="{Binding FormerLabel}"
                      IsVisible="{Binding FormerLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasMemberOf}">
              <TextBlock Text="Member of" Classes="small faint" />
              <ItemsControl ItemsSource="{Binding MemberOf}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemberRow">
                    <Button Classes="chip" Classes.former="{Binding Former}" Classes.local="{Binding InLibrary}"
                            Command="{Binding $parent[ItemsControl].((vm:ArtistProfileViewModel)DataContext).OpenMemberCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Text="{Binding Detail}" Classes="small faint" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <WrapPanel>
              <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="enrich:ArtistLink">
                    <Button Classes="ghost" Margin="0,0,6,6" Content="{Binding Label}" ToolTip.Tip="{Binding Url}"
                            Command="{Binding $parent[ItemsControl].((vm:ArtistProfileViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding Url}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding LookUpCommand}" IsEnabled="{Binding !Busy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IcoRefresh}" Width="14" Height="14" />
                  <TextBlock Text="{Binding LookupLabel}" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Classes="muted small" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding Candidates}" IsVisible="{Binding HasCandidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CandidateRow">
                  <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                          Command="{Binding $parent[ItemsControl].((vm:ArtistProfileViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{StaticResource Text}" />
                      <TextBlock Text="{Binding Detail}" Classes="small muted" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Albums}" Margin="16,0,16,16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:AlbumSummary">
              <Button Classes="flat albumcard" Width="184" Margin="4" Padding="8" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((vm:AlbumsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                <StackPanel Spacing="8">
                  <Border Width="168" Height="168" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Surface3}">
                    <Panel>
                      <Path Classes="icon" Data="{StaticResource IcoAlbum}" Width="48" Height="48" Stroke="{StaticResource Faint}" StrokeThickness="1.2" />
                      <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="336" />
                      <Button Classes="play" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                              Background="{StaticResource Accent}" Foreground="White" ToolTip.Tip="Play album"
                              Command="{Binding $parent[ItemsControl].((vm:AlbumsViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}">
                        <Path Classes="icon fill" Data="{StaticResource IcoPlay}" Width="16" Height="16" Margin="2,0,0,0" />
                      </Button>
                    </Panel>
                  </Border>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Artist}" /><Run Text="  " /><Run Text="{Binding Date, Converter={x:Static ui:Converters.Year}}" Foreground="{StaticResource Faint}" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !Albums.Count}">
        <TextBlock Classes="h2" HorizontalAlignment="Center">No albums yet</TextBlock>
        <TextBlock Classes="muted" HorizontalAlignment="Center">Add a music folder under Sources; scanning runs in the background.</TextBlock>
      </StackPanel>
    </Panel>
  </DockPanel>
  <UserControl.Styles>
    <!-- the card's play button only shows on hover -->
    <Style Selector="Button.albumcard Button.play"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Button.albumcard:pointerover Button.play"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2,10,2" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.chip.former"><Setter Property="Opacity" Value="0.7" /></Style>
    <Style Selector="Button.chip:not(.local)"><Setter Property="Cursor" Value="Arrow" /></Style>
    <Style Selector="Button.chip:not(.local):pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Button.chip.local"><Setter Property="Cursor" Value="Hand" /></Style>
  </UserControl.Styles>
</UserControl>
