<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             x:Class="LocalFM.UI.Views.FieldBox"
             x:DataType="vm:EditField">
  <Grid ColumnDefinitions="*,Auto">
    <AutoCompleteBox Classes="field" Classes.changed="{Binding IsChanged}"
                     Text="{Binding Value, Mode=TwoWay}" ItemsSource="{Binding Suggestions}"
                     FilterMode="ContainsOrdinal" MinimumPrefixLength="1" MaxDropDownHeight="240" />
    <ToggleButton Grid.Column="1" Classes="lock" IsChecked="{Binding Locked, Mode=TwoWay}" ToolTip.Tip="{Binding LockTip}" Margin="2,0,0,0">
      <Panel>
        <Path Classes="icon" Data="{StaticResource IcoLock}" Width="14" Height="14" IsVisible="{Binding Locked}" />
        <Path Classes="icon" Data="{StaticResource IcoUnlock}" Width="14" Height="14" IsVisible="{Binding !Locked}" />
      </Panel>
    </ToggleButton>
  </Grid>
</UserControl>
