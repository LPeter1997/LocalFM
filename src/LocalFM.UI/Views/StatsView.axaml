<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:c="using:LocalFM.UI.Controls"
             x:Class="LocalFM.UI.Views.StatsView"
             x:DataType="vm:StatsViewModel">
  <UserControl.Resources>
    <!-- A ranked row: number, cover, names, amount and a share bar. -->
    <DataTemplate x:Key="TopRowTemplate" x:DataType="vm:TopRow">
      <Button Classes="row" Command="{Binding $parent[UserControl].((vm:StatsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="22,Auto,*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Grid.RowSpan="2" Text="{Binding Rank}" Classes="faint small" VerticalAlignment="Center" />
          <Border Grid.Column="1" Grid.RowSpan="2" Width="38" Height="38" CornerRadius="5" ClipToBounds="True"
                  Background="{StaticResource Surface3}" Margin="0,0,10,0">
            <Panel>
              <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="16" Height="16" Stroke="{StaticResource Faint}" />
              <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="80" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" Classes="muted small" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="{Binding Amount}" Classes="small" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Detail}" Classes="faint small" HorizontalAlignment="Right" />
          </StackPanel>
          <ProgressBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Share}"
                       Height="2" MinHeight="2" Margin="0,5,0,0" Foreground="{StaticResource Accent}" Background="Transparent" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,0,24,24" Spacing="14">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="h1" Text="Stats" />
        <CheckBox Grid.Column="1" IsChecked="{Binding RankByTime}" Content="Rank by time" Margin="0,0,14,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" MinWidth="160" VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StatsPeriodOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <TextBlock Text="{Binding EmptyText}" Classes="muted" IsVisible="{Binding !HasData}" Margin="0,8" />

      <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,-14,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatTile">
            <Border Classes="card" Margin="0,0,14,0" Padding="16,14">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Label}" Classes="muted small" />
                <TextBlock Text="{Binding Note}" Classes="faint small" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="14" IsVisible="{Binding HasData}">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding TimelineTitle}" />
            <c:BarChart Data="{Binding Timeline}" Height="170" BarBrush="{StaticResource Accent}" LabelBrush="{StaticResource Faint}" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="3*,14,2*">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Time of day" />
              <c:BarChart Data="{Binding Hours}" Height="120" BarBrush="{StaticResource Accent}" LabelBrush="{StaticResource Faint}" />
              <TextBlock Text="{Binding Habit}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Day of week" />
              <c:BarChart Data="{Binding Weekdays}" Height="120" BarBrush="{StaticResource Accent}" LabelBrush="{StaticResource Faint}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,14,*,14,*">
          <Border Classes="card">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="Top tracks" />
                <Button Grid.Column="1" Classes="ghost" Command="{Binding PlayTopTracksCommand}" ToolTip.Tip="Play these as a mix">Play</Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding TopTracks}" ItemTemplate="{StaticResource TopRowTemplate}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="h2" Text="Top artists" Margin="0,4" />
              <ItemsControl ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource TopRowTemplate}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="h2" Text="Top albums" Margin="0,4" />
              <ItemsControl ItemsSource="{Binding TopAlbums}" ItemTemplate="{StaticResource TopRowTemplate}" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <Grid ColumnDefinitions="*,14,*">
        <StackPanel Spacing="14">
          <Border Classes="card" IsVisible="{Binding Coverage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Your library" />
              <TextBlock Text="{Binding Coverage}" Classes="muted" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding CoverageShare}" Height="6" MinHeight="6" CornerRadius="3"
                           Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasForgotten}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="h2" Text="Forgotten favourites" />
                  <TextBlock Classes="faint small" Text="Played a lot once, not in the last two months" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Command="{Binding PlayForgottenCommand}" VerticalAlignment="Top">Play</Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Forgotten}" ItemTemplate="{StaticResource TopRowTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasData}" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Recently played" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentRow">
                  <Button Classes="row" Command="{Binding $parent[UserControl].((vm:StatsViewModel)DataContext).PlayRecentCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Surface3}" Margin="0,0,10,0">
                        <Panel>
                          <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="14" Height="14" Stroke="{StaticResource Faint}" />
                          <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="64" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding When}" Classes="small muted" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Note}" Classes="small faint" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
