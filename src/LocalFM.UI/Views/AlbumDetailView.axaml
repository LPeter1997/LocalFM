<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             x:Class="LocalFM.UI.Views.AlbumDetailView"
             x:DataType="vm:AlbumDetailViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,4,24,16">
      <Border Width="200" Height="200" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Surface3}" BoxShadow="0 8 30 0 #60000000">
        <Panel>
          <Path Classes="icon" Data="{StaticResource IcoAlbum}" Width="64" Height="64" Stroke="{StaticResource Faint}" StrokeThickness="1.2" />
          <c:CoverImage Path="{Binding Album.CoverPath}" DecodeWidth="400" />
        </Panel>
      </Border>
      <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom" Spacing="6">
        <TextBlock Classes="muted small" Text="ALBUM" FontWeight="SemiBold" LetterSpacing="1" />
        <TextBlock Classes="h1" FontSize="34" Text="{Binding Album.Title}" TextWrapping="Wrap" />
        <TextBlock>
          <Run Text="{Binding Album.Artist}" FontWeight="SemiBold" />
          <Run Text="  ·  " Foreground="{StaticResource Faint}" />
          <Run Text="{Binding Year}" Foreground="{StaticResource Muted}" />
          <Run Text="  ·  " Foreground="{StaticResource Faint}" />
          <Run Text="{Binding Summary}" Foreground="{StaticResource Muted}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Classes="primary" Command="{Binding PlayAllCommand}">Play</Button>
          <Button Classes="ghost" Command="{Binding ShuffleAllCommand}">Shuffle</Button>
          <Button Classes="ghost" Command="{Binding PlayAlbumNextCommand}">Play next</Button>
          <Button Classes="ghost" Command="{Binding EnqueueAlbumCommand}">Add to queue</Button>
        </StackPanel>
      </StackPanel>
    </Grid>
    <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Tracks}" Margin="16,0,16,8">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="lib:TrackInfo">
          <Grid ColumnDefinitions="44,*,Auto,64">
            <TextBlock Classes="faint" VerticalAlignment="Center">
              <Run Text="{Binding Position}" />
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Codec}" Classes="faint small" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Grid.Column="3" Text="{Binding DurationMs, Converter={x:Static ui:Converters.Duration}}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
