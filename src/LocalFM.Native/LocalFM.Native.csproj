<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\LocalFM.Core\LocalFM.Core.csproj" />
  </ItemGroup>

  <!-- localfm_native is built with CMake (native/CMakeLists.txt) into native/out/<rid>/, next to the FFmpeg it ships
       with (native/build.sh for packages and CI). Everything in that folder is copied beside the app. A Linux dev
       build without a RID builds it automatically when missing, against the system's FFmpeg; never on CI, where the
       library comes from .github/actions/native (and the Android build has no system FFmpeg to build it with). -->
  <PropertyGroup>
    <NativeRid>$(RuntimeIdentifier)</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</NativeRid>
    <NativeRidDir>$(NativeOutDir)$(NativeRid)/</NativeRidDir>
    <NativeLinuxLib>$(NativeRidDir)liblocalfm_native.so</NativeLinuxLib>
  </PropertyGroup>

  <Target Name="BuildNativeIfMissing" BeforeTargets="AssignTargetPaths"
          Condition="'$(CI)' != 'true' And $([MSBuild]::IsOSPlatform('Linux')) And '$(NativeRid)' == '$(NETCoreSdkPortableRuntimeIdentifier)' And !Exists('$(NativeLinuxLib)')">
    <Exec Command="&quot;$(RepoRoot)native/build-linux.sh&quot;" />
  </Target>

  <!-- Items are added inside a target so a library built moments ago is picked up. -->
  <Target Name="IncludeNativeLibs" AfterTargets="BuildNativeIfMissing" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <NativeFile Include="$(NativeRidDir)*" Exclude="$(NativeRidDir)*.pdb;$(NativeRidDir)*.lib;$(NativeRidDir)*.exp;$(NativeRidDir)*.dbg" />
      <None Include="@(NativeFile)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Warning Condition="'@(NativeFile)' == ''" Text="No native library for $(NativeRid) in $(NativeRidDir): build it with native/build.sh (see docs/release.md)." />
  </Target>
</Project>
