<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             x:Class="LocalFM.UI.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">
  <ScrollViewer>
  <StackPanel Margin="24,0,24,12" Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
    <TextBlock Classes="h1" Text="Sources" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Intro}" />
    <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16,14" IsVisible="{Binding MusicAccessMissing}">
      <StackPanel Spacing="10">
        <TextBlock Text="LocalFM needs your permission to read the music on this phone" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Only audio files are read, from the folders listed here (the Music folder to start with). Nothing leaves the phone." />
        <Button Classes="primary" Command="{Binding AllowMusicAccessCommand}" HorizontalAlignment="Left">Allow access</Button>
      </StackPanel>
    </Border>
    <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding !MusicAccessMissing}">
      <Button Classes="primary" Command="{Binding AddFolderCommand}">Add folder…</Button>
      <Button Classes="ghost" Command="{Binding ExcludeFolderCommand}"
              ToolTip.Tip="Skip a folder inside a source, e.g. where another app saves recordings">Exclude folder…</Button>
      <Button Classes="ghost" Command="{Binding RescanAllCommand}">Rescan all</Button>
    </WrapPanel>
    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="lib:Source">
          <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:Icon Classes="icon" Data="{StaticResource IcoFolder}" Stroke="{StaticResource Muted}" />
              <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" Margin="12,0" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}" />
              <Button Grid.Column="2" Classes="flat" ToolTip.Tip="Remove source (its tracks are kept as missing)"
                      Command="{Binding $parent[UserControl].((vm:SourcesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                <c:Icon Classes="icon" Data="{StaticResource IcoTrash}" Width="16" Height="16" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Spacing="6" IsVisible="{Binding HasExcluded}">
      <TextBlock Classes="muted small" Text="Excluded folders (skipped when scanning)" Margin="0,4,0,0" />
      <ItemsControl ItemsSource="{Binding Excluded}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Classes="icon" Data="{StaticResource IcoFolder}" Stroke="{StaticResource Faint}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding}" VerticalAlignment="Center" Margin="12,0" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding}" />
                <Button Grid.Column="2" Classes="flat" ToolTip.Tip="Stop excluding (its music is scanned again)"
                        Command="{Binding $parent[UserControl].((vm:SourcesViewModel)DataContext).UnexcludeCommand}" CommandParameter="{Binding}">
                  <c:Icon Classes="icon" Data="{StaticResource IcoClose}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <TextBlock Classes="h2" Text="Online metadata" Margin="0,14,0,0" />
    <TextBlock Classes="muted" TextWrapping="Wrap">
      LocalFM works fully offline. When allowed, it asks free services (MusicBrainz, Cover Art Archive, iTunes, LRCLIB,
      Wikidata and Wikipedia) about your music: album and track details, covers, lyrics and artist profiles.
      Answers are stored locally, so each question is asked once.
    </TextBlock>
    <CheckBox IsChecked="{Binding OnlineEnabled}">Use online services</CheckBox>
    <CheckBox IsChecked="{Binding AutoFetchLyrics}" IsEnabled="{Binding OnlineEnabled}">Look up lyrics automatically when a track starts</CheckBox>
    <CheckBox IsChecked="{Binding EstimateWordTiming}">Highlight lyrics word by word, estimating the timing for lyrics that are only synced by line</CheckBox>
    <StackPanel Spacing="10" DataContext="{Binding Share}" x:DataType="vm:ShareViewModel" IsVisible="{Binding Available}">
      <TextBlock Classes="h2" Text="TV and other devices" Margin="0,14,0,0" />
      <TextBlock Classes="muted" TextWrapping="Wrap">
        Play your library on a smart TV or in any web browser at home. They browse and play on their own, streaming
        from this computer while LocalFM runs. Only devices on your home network that you paired can connect.
      </TextBlock>
      <CheckBox IsChecked="{Binding Enabled}">Share my library on this network</CheckBox>
      <TextBlock Classes="small" Foreground="{StaticResource Accent}" Text="{Binding Error}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Spacing="10" IsVisible="{Binding Enabled}">
        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="muted small" Text="Open this address in the TV's web browser or the LocalFM TV app" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <SelectableTextBlock Text="{Binding Address, TargetNullValue='No home network found'}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="ghost" Content="Copy" Command="{Binding CopyAddressCommand}" VerticalAlignment="Center"
                      IsVisible="{Binding Address, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Classes="faint small" Text="{Binding OtherAddresses}" TextWrapping="Wrap"
                       IsVisible="{Binding OtherAddresses, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Pairing}">
          <Button Classes="ghost" Command="{Binding PairCommand}">Pair a device…</Button>
        </StackPanel>
        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16,14" IsVisible="{Binding Pairing}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted small" Text="Enter this PIN on the device (valid for 10 minutes, once)" />
              <SelectableTextBlock Text="{Binding Pin}" FontSize="28" FontWeight="SemiBold" LetterSpacing="6" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding StopPairingCommand}">Done</Button>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding HasDevices}">
        <TextBlock Classes="muted small" Text="Paired devices" Margin="0,4,0,0" />
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShareDeviceRow">
              <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:Icon Classes="icon" Data="{StaticResource IcoTv}" Stroke="{StaticResource Muted}" />
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="faint small" Text="{Binding Detail}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="flat" ToolTip.Tip="Remove (it has to pair again to connect)"
                          Command="{Binding $parent[ItemsControl].((vm:ShareViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                    <c:Icon Classes="icon" Data="{StaticResource IcoTrash}" Width="16" Height="16" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
    <TextBlock Classes="h2" Text="Knowledge base file" Margin="0,14,0,0" />
    <TextBlock Classes="muted" TextWrapping="Wrap">
      Everything LocalFM knows about your music, in one file: corrected names, locks, album details, covers, artist
      profiles, lyrics, playlists and (optionally) listening history. Not the music itself, and no folder paths.
      Importing merges into this library: albums are recognised by their audio, so it works on another computer
      with the same files, and local edits win.
    </TextBlock>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="ghost" Command="{Binding ExportBundleCommand}" IsEnabled="{Binding !BundleBusy}" IsVisible="{Binding CanExport}">Export…</Button>
      <Button Classes="ghost" Command="{Binding ImportBundleCommand}" IsEnabled="{Binding !BundleBusy}">Import…</Button>
      <CheckBox IsChecked="{Binding IncludeHistory}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding CanExport}">Include listening history</CheckBox>
    </StackPanel>
    <TextBlock Text="{Binding BundleStatus}" Classes="muted small" TextWrapping="Wrap"
               IsVisible="{Binding BundleStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="faint small" TextWrapping="Wrap"><Run Text="Library data: " /><Run Text="{Binding DataFolder}" /></TextBlock>
    <TextBlock Classes="h2" Text="Updates" Margin="0,14,0,0" />
    <StackPanel Spacing="10" DataContext="{Binding Updater}" x:DataType="vm:UpdaterViewModel">
      <TextBlock Classes="muted" TextWrapping="Wrap"><Run Text="{Binding CurrentVersion, StringFormat='LocalFM {0}. '}" /><Run Text="{Binding ModeText}" /></TextBlock>
      <CheckBox IsChecked="{Binding CheckOnStart}" IsVisible="{Binding CanCheck}">Check for updates when LocalFM starts</CheckBox>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanCheck}">
        <Button Classes="ghost" Command="{Binding CheckNowCommand}">Check now</Button>
        <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanAddToMenu}">
        <Button Classes="ghost" Command="{Binding AddToMenuCommand}">Add to applications menu</Button>
        <TextBlock Text="{Binding MenuText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
