<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:lib="using:LocalFM.Library"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             xmlns:v="using:LocalFM.UI.Views"
             xmlns:enrich="using:LocalFM.Library.Enrich"
             x:Class="LocalFM.UI.Views.AlbumDetailView"
             x:DataType="vm:AlbumDetailViewModel">
  <DockPanel>
    <!-- Cover beside the title; on a phone above it -->
    <Grid x:Name="Header" DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
      <Border x:Name="HeaderCover" Width="200" Height="200" CornerRadius="10" ClipToBounds="True" Background="{StaticResource Surface3}" BoxShadow="0 8 30 0 #60000000">
        <Panel>
          <c:Icon Classes="icon" Data="{StaticResource IcoAlbum}" Width="64" Height="64" Stroke="{StaticResource Faint}" StrokeThickness="1.2" />
          <c:CoverImage Path="{Binding Album.CoverPath}" DecodeWidth="400" />
          <Button Classes="ghost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" FontSize="12"
                  Command="{Binding FetchCoverCommand}" IsVisible="{Binding Album.CoverPath, Converter={x:Static ObjectConverters.IsNull}}">Fetch cover</Button>
        </Panel>
      </Border>
      <StackPanel x:Name="HeaderInfo" VerticalAlignment="Bottom" Spacing="6">
        <TextBlock Classes="muted small" Text="ALBUM" FontWeight="SemiBold" LetterSpacing="1" />
        <TextBlock x:Name="HeaderTitle" FontWeight="Bold" Text="{Binding Album.Title}" TextWrapping="Wrap" />
        <TextBlock>
          <!-- One line: a line break between runs would add a space before the dot -->
          <Run Text="{Binding Album.Artist}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{StaticResource Faint}" /><Run Text="{Binding Summary}" Foreground="{StaticResource Muted}" />
        </TextBlock>
        <WrapPanel Margin="0,10,0,0" ItemSpacing="8" LineSpacing="8">
          <Button Classes="primary" Command="{Binding PlayAllCommand}">Play</Button>
          <Button Classes="ghost" Command="{Binding ShuffleAllCommand}">Shuffle</Button>
          <Button Classes="ghost" Command="{Binding PlayAlbumNextCommand}">Play next</Button>
          <Button Classes="ghost" Command="{Binding EnqueueAlbumCommand}">Add to queue</Button>
          <Button Classes="ghost" Command="{Binding ToggleMatchCommand}" ToolTip.Tip="Match this album with MusicBrainz" IsVisible="{Binding CanEdit}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Classes="icon" Data="{StaticResource IcoMagic}" Width="15" Height="15" />
              <TextBlock Text="Find metadata" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding EditCommand}" ToolTip.Tip="Edit titles, artists and numbers by hand" IsVisible="{Binding CanEdit}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Classes="icon" Data="{StaticResource IcoEdit}" Width="15" Height="15" />
              <TextBlock Text="Edit" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <TextBlock Text="{Binding CoverStatus}" Classes="muted small" IsVisible="{Binding CoverStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Margin="24,0,24,12" Padding="14,10" CornerRadius="10" Background="{StaticResource Surface}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="CanEdit" />
          <Binding Path="Copies.Count" Converter="{x:Static ui:Converters.Positive}" />
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Spacing="6">
        <TextBlock Classes="muted small" Text="Another copy of this album is in your library. Merging moves its songs here." TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Copies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:AlbumSummary">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Title}" FontWeight="Medium" /><Run Text="    " />
                  <Run Text="{Binding Converter={x:Static ui:Converters.AlbumFacts}, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                </TextBlock>
                <Button Grid.Column="1" Classes="ghost" FontSize="12" Margin="12,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:AlbumDetailViewModel)DataContext).MergeCopyCommand}" CommandParameter="{Binding}">Merge into this album</Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Margin="24,0,24,12" Padding="14" CornerRadius="10" Background="{StaticResource Surface}"
            IsVisible="{Binding Move, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel DataContext="{Binding Move}" x:DataType="vm:MoveViewModel" Spacing="10">
        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <!-- Online: the albums MusicBrainz says the songs are on -->
        <TextBlock Classes="muted small" Text="{Binding OnlineHeading}" />
        <TextBlock Text="{Binding OnlineStatus}" Classes="faint small" TextWrapping="Wrap"
                   IsVisible="{Binding OnlineStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ListBox x:Name="MoveOnline" Classes="rows" ItemsSource="{Binding Online}" SelectedItem="{Binding SelectedOnline}" MaxHeight="180"
                 IsVisible="{Binding Online.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AlbumGuessRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="small" Text="in your library" Foreground="{StaticResource Accent}" Margin="10,0"
                           VerticalAlignment="Center" IsVisible="{Binding InLibrary}" />
                <TextBlock Grid.Column="2" Classes="muted small" VerticalAlignment="Center" Text="{Binding Facts}" />
                <TextBlock Grid.Column="3" Classes="small" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Coverage}" Margin="10,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- In the library -->
        <TextBlock Classes="muted small" Text="In your library" Margin="0,4,0,0" />
        <TextBox x:Name="MoveSearch" Text="{Binding Search}" PlaceholderText="Search albums by title or artist" />
        <TextBlock Text="{Binding Status}" Classes="muted small" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ListBox x:Name="MoveResults" Classes="rows" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="200"
                 IsVisible="{Binding Results.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="lib:AlbumSummary">
              <Grid ColumnDefinitions="36,*,Auto">
                <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                  <Panel>
                    <c:Icon Classes="icon" Data="{StaticResource IcoAlbum}" Width="16" Height="16" Stroke="{StaticResource Faint}" />
                    <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="64" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="muted small" VerticalAlignment="Center"
                           Text="{Binding Converter={x:Static ui:Converters.AlbumFacts}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <Button Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding !Busy}">Move to selected album</Button>
          <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Command="{Binding CancelCommand}">Cancel</Button>
          <TextBox x:Name="NewAlbumBox" Grid.Column="3" Text="{Binding NewAlbumName}" PlaceholderText="Or a new album…" Width="200">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding CreateNewCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="4" Classes="ghost" Margin="8,0,0,0" Command="{Binding CreateNewCommand}" IsEnabled="{Binding !Busy}">Create</Button>
        </Grid>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Margin="24,0,24,12" Padding="14" CornerRadius="10" Background="{StaticResource Surface}"
            IsVisible="{Binding MatchOpen}">
      <StackPanel DataContext="{Binding Match}" x:DataType="vm:MatchViewModel" Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ListBox Classes="segmented" ItemsSource="{Binding Modes}" SelectedIndex="{Binding Mode}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <CheckBox Grid.Column="2" IsChecked="{Binding FetchCover}" Margin="12,0,0,0">Download cover</CheckBox>
        </Grid>
        <Grid ColumnDefinitions="*,*,Auto" IsVisible="{Binding ByTitle}">
          <TextBox Text="{Binding Title}" PlaceholderText="Album title" Margin="0,0,8,0">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <TextBox Grid.Column="1" Text="{Binding Artist}" PlaceholderText="Artist (optional)" Margin="0,0,8,0">
            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="ghost" Command="{Binding SearchCommand}" IsEnabled="{Binding !Busy}">Search</Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowStatus}">
          <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="ghost" FontSize="12" Command="{Binding FindTheirAlbumsCommand}" IsVisible="{Binding HasStrays}">Find their albums</Button>
        </StackPanel>

        <!-- By songs -->
        <StackPanel Spacing="10" IsVisible="{Binding BySongs}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding FindBySongsCommand}" IsEnabled="{Binding !Busy}">Look up</Button>
            <!-- a lone song can be looked up by a corrected title; the artist goes for every song -->
            <UniformGrid Rows="1" Margin="0,0,8,0">
              <TextBox Text="{Binding LookupTitle}" PlaceholderText="Song title" Margin="0,0,8,0" IsVisible="{Binding SingleSong}">
                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding FindBySongsCommand}" /></TextBox.KeyBindings>
              </TextBox>
              <TextBox Text="{Binding LookupArtist}" PlaceholderText="Artist">
                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding FindBySongsCommand}" /></TextBox.KeyBindings>
              </TextBox>
            </UniformGrid>
          </DockPanel>
          <Border CornerRadius="8" Background="{StaticResource Surface2}" Padding="12,8" IsVisible="{Binding CanSort}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SortSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="primary" Margin="12,0,0,0" Command="{Binding SortAllCommand}" IsEnabled="{Binding !Busy}">Sort them</Button>
            </Grid>
          </Border>
          <ListBox x:Name="GuessList" Classes="rows" ItemsSource="{Binding Guesses}" SelectedItem="{Binding SelectedGuess}" MaxHeight="260"
                   IsVisible="{Binding Guesses.Count}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumGuessRow">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="small" Text="in your library" Foreground="{StaticResource Accent}" Margin="10,0"
                             VerticalAlignment="Center" IsVisible="{Binding InLibrary}" />
                  <TextBlock Grid.Column="2" Classes="muted small" VerticalAlignment="Center" Text="{Binding Facts}" Margin="10,0" />
                  <TextBlock Grid.Column="3" Classes="small" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Coverage}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="primary" Command="{Binding ApplyGuessCommand}" IsEnabled="{Binding !Busy}" IsVisible="{Binding HasGuesses}">Put on selected album</Button>
        </StackPanel>

        <!-- By album title -->
        <StackPanel Spacing="10" IsVisible="{Binding ByTitle}">
        <ListBox Classes="rows" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}" MaxHeight="260"
                 IsVisible="{Binding Candidates.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="enrich:ReleaseCandidate">
              <Grid ColumnDefinitions="2.2*,1.1*,1.3*,1.4*,44">
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Artist}" /><Run Text="  " /><Run Text="{Binding Disambiguation}" Foreground="{StaticResource Faint}" />
                  </TextBlock>
                  <TextBlock Classes="small" Text="in your library" Foreground="{StaticResource Accent}" IsVisible="{Binding InLibrary}"
                             ToolTip.Tip="Another album in your library is this release; applying it moves these songs there" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center">
                  <Run Text="{Binding Date}" /><Run Text="  " /><Run Text="{Binding Country}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Format}" /><Run Text=" · " /><Run Text="{Binding TrackCount, Converter={x:Static ui:Converters.Tracks}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Column="3" Classes="faint small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Label}" /><Run Text="  " /><Run Text="{Binding CatalogNumber}" />
                </TextBlock>
                <Border Grid.Column="4" CornerRadius="6" Background="{StaticResource Surface3}" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Score}" Classes="small" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding !Busy}">Apply selected release</Button>
          <TextBlock Classes="faint small" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Fields you have edited by hand are never overwritten." />
        </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Tracks}" Margin="16,0,16,8" SelectionMode="Multiple">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="lib:TrackInfo">
          <Grid ColumnDefinitions="44,*,Auto,64">
            <TextBlock Classes="faint" VerticalAlignment="Center">
              <Run Text="{Binding Position}" />
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Codec}" Classes="faint small" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Grid.Column="3" Text="{Binding DurationMs, Converter={x:Static ui:Converters.Duration}}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
  <UserControl.Styles>
    <Style Selector="Grid#Header"><Setter Property="Margin" Value="24,4,24,16" /></Style>
    <Style Selector="StackPanel#HeaderInfo">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="24,0,0,0" />
    </Style>
    <Style Selector="TextBlock#HeaderTitle"><Setter Property="FontSize" Value="34" /></Style>
    <!-- Phone: the cover above the title, centred -->
    <Style Selector="v|MainView.compact Grid#Header"><Setter Property="Margin" Value="16,0,16,12" /></Style>
    <Style Selector="v|MainView.compact Border#HeaderCover">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="v|MainView.compact StackPanel#HeaderInfo">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style Selector="v|MainView.compact TextBlock#HeaderTitle"><Setter Property="FontSize" Value="26" /></Style>
  </UserControl.Styles>
</UserControl>
