<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalFM.UI.ViewModels"
             xmlns:v="using:LocalFM.UI.Views"
             xmlns:c="using:LocalFM.UI.Controls"
             xmlns:ui="using:LocalFM.UI"
             xmlns:net="using:LocalFM.Vibe.Net"
             xmlns:host="using:LocalFM.Vibe.Host"
             x:Class="LocalFM.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:AlbumsViewModel"><v:AlbumsView /></DataTemplate>
    <DataTemplate DataType="vm:AlbumDetailViewModel"><v:AlbumDetailView /></DataTemplate>
    <DataTemplate DataType="vm:ArtistsViewModel"><v:ArtistsView /></DataTemplate>
    <DataTemplate DataType="vm:TracksViewModel"><v:TracksView /></DataTemplate>
    <DataTemplate DataType="vm:PlaylistsViewModel"><v:PlaylistsView /></DataTemplate>
    <DataTemplate DataType="vm:QueueViewModel"><v:QueueView /></DataTemplate>
    <DataTemplate DataType="vm:SourcesViewModel"><v:SourcesView /></DataTemplate>
    <DataTemplate DataType="vm:ImportViewModel"><v:ImportView /></DataTemplate>
    <DataTemplate DataType="vm:AlbumEditorViewModel"><v:AlbumEditorView /></DataTemplate>
    <DataTemplate DataType="vm:TidyViewModel"><v:TidyView /></DataTemplate>
    <DataTemplate DataType="vm:SoundViewModel"><v:SoundView /></DataTemplate>
    <DataTemplate DataType="vm:StatsViewModel"><v:StatsView /></DataTemplate>
    <DataTemplate DataType="vm:MoreViewModel"><v:MoreView /></DataTemplate>
  </UserControl.DataTemplates>

  <!-- Rows: title, pages, update banner, player bar, (phone) bottom bar. On a phone a full-screen sheet (now
       playing, lyrics, the vibe) collapses the other rows, so the page row fills the screen. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Background="{StaticResource Surface}">
    <!-- Our own title bar: drag to move, double-click to maximize; the page sheet below tucks into it -->
    <Grid x:Name="TitleBar" Height="48" ColumnDefinitions="Auto,Auto,*,*,Auto" Background="{StaticResource Surface}"
          IsVisible="{Binding !SheetOpen}">
      <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="8" Margin="20,0,0,0" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent}">
          <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="15" Height="15" Stroke="White" />
        </Border>
        <TextBlock Classes="wideonly" Text="LocalFM" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Classes="flat" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" Margin="8,0,0,0" ToolTip.Tip="Back (Alt+Left)">
        <c:Icon Classes="icon" Data="{StaticResource IcoBack}" />
      </Button>
      <!-- The search box takes up to 280 px and gives way when the window is narrow -->
      <TextBox Grid.Column="3" x:Name="Search" PlaceholderText="Search" MaxWidth="280" VerticalAlignment="Center" Margin="12,0,12,0"
               Text="{Binding SearchText}" IsVisible="{Binding CurrentPage.Searchable}"
               CornerRadius="18" Padding="14,7" Background="{StaticResource Surface2}" BorderThickness="0" />
      <!-- The window's caption buttons (desktop) -->
      <ContentControl Grid.Column="4" x:Name="CaptionSlot" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- Sidebar -->
      <Border x:Name="Sidebar" Width="216" Background="{StaticResource Surface}">
        <DockPanel Margin="12,6,12,12">
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="8,0">
            <TextBlock Text="{Binding ScanStatus}" Classes="small" Foreground="{StaticResource Accent}"
                       IsVisible="{Binding ScanStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Counts}" Classes="small faint" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:Icon Classes="icon" Data="{Binding Icon}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium" Margin="12,0,0,0" />
                  <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" ToolTip.Tip="Fixes ready in Tidy up">
                    <TextBlock Text="{Binding BadgeText}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- The page sheet: pages, the now-playing view and the lyrics panel -->
      <Border Grid.Column="1" x:Name="Sheet" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" ClipToBounds="True">
      <Grid ColumnDefinitions="*,Auto">
      <ContentControl Content="{Binding CurrentPage}" Margin="0,20,0,0" />

      <!-- Now playing view: big cover, the visualizer, colours from the cover -->
      <Panel IsVisible="{Binding NowPlayingOpen}" Background="{StaticResource Bg}" ClipToBounds="True">
        <c:CoverImage Path="{Binding NowPlaying.CoverPath}" DecodeWidth="256" Opacity="0.28" Margin="-80">
          <c:CoverImage.Effect><BlurEffect Radius="70" /></c:CoverImage.Effect>
        </c:CoverImage>
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#66111114" />
              <GradientStop Offset="1" Color="#F2111114" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Grid Classes="wideonly" RowDefinitions="Auto,*,Auto" Margin="32,18,32,24">
          <!-- Closed with the same player-bar button that opened it (or V / Esc) -->
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="h2" Text="Now playing" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="chip" IsChecked="{Binding CoverColours}" Margin="0,0,10,0"
                          ToolTip.Tip="Tint the app with colours from the album cover">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <c:Icon Classes="icon" Data="{StaticResource IcoPalette}" Width="16" Height="16" />
                <TextBlock Text="Cover colours" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ListBox Grid.Column="2" Classes="segmented" ItemsSource="{Binding VisualizerModes}" SelectedItem="{Binding VisualizerMode}"
                     ToolTip.Tip="Visualizer">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,16">
            <!-- Up to 420 px, shrinking with the window -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" MaxWidth="420">
              <Border Width="420" Height="420" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,20"
                      Background="{StaticResource Surface3}" BoxShadow="0 18 50 0 #A0000000">
                <Panel>
                  <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="80" Height="80" Stroke="{StaticResource Faint}" />
                  <c:CoverImage Path="{Binding NowPlaying.CoverPath}" DecodeWidth="840" />
                </Panel>
              </Border>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding NowPlaying.Title}" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding NowPlaying.Artist}" FontSize="20" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding NowPlaying.Album}" FontSize="15" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <c:Visualizer Grid.Row="2" Height="200" Source="{Binding Host.Player}" Mode="{Binding VisualizerMode}"
                        Active="{Binding WideVisualizerActive}" BarBrush="{StaticResource Accent}" />
        </Grid>

        <!-- Phone: the whole screen, top to bottom; the player controls live here instead of the bar -->
        <Grid Classes="compactonly" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="16,4,16,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="flat" Command="{Binding ToggleNowPlayingCommand}" ToolTip.Tip="Close">
              <c:Icon Classes="icon" Data="{StaticResource IcoDown}" />
            </Button>
            <ListBox Grid.Column="2" Classes="segmented" ItemsSource="{Binding VisualizerModes}" SelectedItem="{Binding VisualizerMode}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
          </Grid>
          <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="8,16,8,8" VerticalAlignment="Center">
            <Border Width="420" Height="420" CornerRadius="12" ClipToBounds="True"
                    Background="{StaticResource Surface3}" BoxShadow="0 18 50 0 #A0000000">
              <Panel>
                <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="80" Height="80" Stroke="{StaticResource Faint}" />
                <c:CoverImage Path="{Binding NowPlaying.CoverPath}" DecodeWidth="840" />
              </Panel>
            </Border>
          </Viewbox>
          <c:Visualizer Grid.Row="2" Height="72" Margin="0,4,0,8" Source="{Binding Host.Player}" Mode="{Binding VisualizerMode}"
                        Active="{Binding CompactVisualizerActive}" BarBrush="{StaticResource Accent}" />
          <StackPanel Grid.Row="3" Spacing="3" DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Artist}" FontSize="16" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Album}" Classes="muted" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Grid Grid.Row="4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" Margin="0,10,0,0"
                DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel">
            <Slider Grid.ColumnSpan="2" x:Name="CompactSeekSlider" Classes="seek" Minimum="0" Maximum="{Binding Duration}"
                    Value="{Binding Position, Mode=OneWay}" IsEnabled="{Binding HasOwnTrack}" />
            <TextBlock Grid.Row="1" Text="{Binding PositionText}" Classes="faint small" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DurationText}" Classes="faint small" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="5" ColumnDefinitions="*,*,Auto,*,*" Margin="0,6,0,8" IsEnabled="{Binding !IsFollowing}"
                DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel">
            <Button Classes="flat" HorizontalAlignment="Center" Classes.on="{Binding Shuffle}" Command="{Binding ToggleShuffleCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoShuffle}" />
            </Button>
            <Button Grid.Column="1" Classes="flat" HorizontalAlignment="Center" Command="{Binding PreviousCommand}">
              <c:Icon Classes="icon fill" Data="{StaticResource IcoPrev}" Width="26" Height="26" />
            </Button>
            <Button Grid.Column="2" Classes="play big" Command="{Binding PlayPauseCommand}">
              <Panel>
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPlay}" Width="26" Height="26" Margin="4,0,0,0" IsVisible="{Binding !IsPlaying}" />
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPause}" Width="24" Height="24" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <Button Grid.Column="3" Classes="flat" HorizontalAlignment="Center" Command="{Binding NextCommand}">
              <c:Icon Classes="icon fill" Data="{StaticResource IcoNext}" Width="26" Height="26" />
            </Button>
            <Button Grid.Column="4" Classes="flat" HorizontalAlignment="Center" Classes.on="{Binding RepeatOn}" Command="{Binding CycleRepeatCommand}">
              <Panel>
                <c:Icon Classes="icon" Data="{StaticResource IcoRepeat}" />
                <TextBlock Text="1" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding RepeatOne}" />
              </Panel>
            </Button>
          </Grid>
          <Grid Grid.Row="6" ColumnDefinitions="*,*,*,*">
            <Button Classes="flat" HorizontalAlignment="Center" Classes.on="{Binding Lyrics.IsOpen}" Command="{Binding ToggleLyricsCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoLyrics}" />
            </Button>
            <Button Grid.Column="1" Classes="flat" HorizontalAlignment="Center" Command="{Binding OpenQueueCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoQueue}" />
            </Button>
            <Button Grid.Column="2" Classes="flat" HorizontalAlignment="Center" Classes.on="{Binding Vibe.InVibe}" Command="{Binding ToggleVibeCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoVibe}" />
            </Button>
            <ToggleButton Grid.Column="3" Classes="chip icononly" HorizontalAlignment="Center" IsChecked="{Binding CoverColours}">
              <c:Icon Classes="icon" Data="{StaticResource IcoPalette}" Width="18" Height="18" />
            </ToggleButton>
          </Grid>
        </Grid>
      </Panel>

      <!-- Lyrics -->
      <Border x:Name="LyricsPanel" Classes="sidepanel" IsVisible="{Binding Lyrics.IsOpen}">
        <DockPanel DataContext="{Binding Lyrics}" x:DataType="vm:LyricsViewModel" Margin="0,14,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,0,12,8">
            <Button Classes="flat compactonly" Margin="-12,0,4,0" ToolTip.Tip="Close"
                    Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleLyricsCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoBack}" />
            </Button>
            <TextBlock Grid.Column="1" Classes="h2" Text="Lyrics" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="flat" Content="Timing off?" FontSize="12" IsVisible="{Binding Synced}"
                    Command="{Binding OtherVersionCommand}" ToolTip.Tip="Try another synced version from LRCLIB" />
            <Button Grid.Column="3" Classes="flat" Command="{Binding RefetchCommand}" ToolTip.Tip="Look up again">
              <c:Icon Classes="icon" Data="{StaticResource IcoRefresh}" Width="16" Height="16" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Source}" Classes="faint small" Margin="20,8,20,12" />
          <Panel>
            <ScrollViewer x:Name="LyricsScroll">
              <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}" Margin="20,8,20,120">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LyricLineViewModel">
                    <c:KaraokeText Classes="lyric" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}"
                                     Text="{Binding Text}" TextWrapping="Wrap" Tag="{Binding}"
                                     Words="{Binding Words}" Clock="{Binding Clock}" Live="{Binding IsCurrent}"
                                     UnsungBrush="{StaticResource Muted}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="20">
              <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsLoading}" />
              <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Panel>
        </DockPanel>
      </Border>


      <!-- What's new (once, after an update) -->
      <Border Classes="sidepanel" IsVisible="{Binding Updater.WhatsNewOpen}">
        <DockPanel DataContext="{Binding Updater}" x:DataType="vm:UpdaterViewModel" Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,0,20,8">
            <Button Classes="flat compactonly" Margin="-12,0,4,0" ToolTip.Tip="Close" Command="{Binding CloseWhatsNewCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoBack}" />
            </Button>
            <TextBlock Classes="h2" Text="{Binding WhatsNewTitle}" VerticalAlignment="Center" />
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Classes="primary" Content="Got it" Command="{Binding CloseWhatsNewCommand}" HorizontalAlignment="Left" Margin="20,8,20,16" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <c:MarkdownView Markdown="{Binding WhatsNew}" Margin="20,4,20,12" />
          </ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Vibe together -->
      <Border x:Name="VibePanel" Classes="sidepanel" IsVisible="{Binding Vibe.IsOpen}">
        <DockPanel DataContext="{Binding Vibe}" x:DataType="vm:VibeViewModel" Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,0,20,8">
            <Button Classes="flat compactonly" Margin="-12,0,4,0" ToolTip.Tip="Close"
                    Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleVibeCommand}">
              <c:Icon Classes="icon" Data="{StaticResource IcoBack}" />
            </Button>
            <TextBlock Classes="h2" Text="Vibe together" VerticalAlignment="Center" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel Margin="20,4,20,20" Spacing="14">
              <!-- Not in a vibe: start one or join one -->
              <StackPanel Spacing="14" IsVisible="{Binding IsIdle}">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Listen to the same music at the same time with friends. You play, they hear it in sync, each with their own volume and sound." />
                <StackPanel Spacing="6">
                  <TextBlock Classes="faint small" Text="Your name" />
                  <TextBox Text="{Binding Name}" MaxLength="40" />
                </StackPanel>
                <Button Classes="primary" HorizontalAlignment="Left" Content="Start a vibe" Command="{Binding StartHostingCommand}"
                        IsEnabled="{Binding !Busy}" />
                <StackPanel Spacing="6" Margin="0,8,0,0">
                  <TextBlock Classes="faint small" Text="Join a friend's vibe" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding JoinCode}" PlaceholderText="Paste an invite" IsEnabled="{Binding !Busy}">
                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding JoinCommand}" /></TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="ghost" Content="Join" Margin="8,0,0,0" Command="{Binding JoinCommand}"
                            IsEnabled="{Binding !Busy}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasNearby}">
                  <TextBlock Classes="faint small" Text="On this network" />
                  <ItemsControl ItemsSource="{Binding Nearby}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="net:NearbyVibe">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                          <TextBlock Text="{Binding HostName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="1" Classes="ghost" Content="Join"
                                  Command="{Binding $parent[ItemsControl].((vm:VibeViewModel)DataContext).JoinNearbyCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Hosting -->
              <StackPanel Spacing="14" IsVisible="{Binding IsHosting}">
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ReachabilityText}" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="faint small" Text="Invite" />
                  <TextBox Text="{Binding InviteCode}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" />
                  <Button Classes="primary" HorizontalAlignment="Left" Content="Copy invite" Command="{Binding CopyInviteCommand}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding VisibleOnNetwork}" Content="Visible on my network" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="faint small" Text="{Binding ListenersTitle}" />
                  <ItemsControl ItemsSource="{Binding Listeners}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="host:ListenerInfo">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="1" Classes="flat" ToolTip.Tip="Remove from the vibe"
                                  Command="{Binding $parent[ItemsControl].((vm:VibeViewModel)DataContext).KickCommand}"
                                  CommandParameter="{Binding}">
                            <c:Icon Classes="icon" Data="{StaticResource IcoClose}" Width="14" Height="14" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Button Classes="ghost" HorizontalAlignment="Left" Content="End vibe" Command="{Binding StopCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>

              <!-- Listening -->
              <StackPanel Spacing="14" IsVisible="{Binding IsListening}">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="Listening with " /><Run Text="{Binding HostName}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ListeningStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ListeningStatus}" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="faint small" Text="Here" />
                  <ItemsControl ItemsSource="{Binding People}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="faint small" TextWrapping="Wrap"
                           Text="The host picks the music. Your own queue is back when you leave." />
                <Button Classes="ghost" HorizontalAlignment="Left" Content="Leave" Command="{Binding StopCommand}" IsEnabled="{Binding !Busy}" />
              </StackPanel>

              <ProgressBar IsIndeterminate="True" Width="120" HorizontalAlignment="Left" IsVisible="{Binding Busy}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Text="{Binding Error}"
                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>
      </Border>
    </Grid>

    <!-- Update banner (Updater) -->
    <Border Grid.Row="2" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,7">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Updater.ShowBanner" />
          <Binding Path="!SheetOpen" />
        </MultiBinding>
      </Border.IsVisible>
      <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Updater}" x:DataType="vm:UpdaterViewModel">
        <c:Icon Classes="icon" Data="{StaticResource IcoImport}" Width="16" Height="16" Stroke="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding BannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
          <Button Classes="primary" Content="When I quit" Command="{Binding UpdateOnQuitCommand}" IsVisible="{Binding IsInApp}" IsEnabled="{Binding CanAct}"
                  ToolTip.Tip="Download it now and install it when you quit LocalFM (closing to the tray is not quitting)" />
          <Button Classes="ghost" Content="Restart now" Command="{Binding RestartNowCommand}" IsVisible="{Binding CanRestart}" IsEnabled="{Binding CanAct}"
                  ToolTip.Tip="Install it now and restart; the music picks up where it was" />
          <Button Classes="primary" Content="Release notes" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding IsNoticeOnly}"
                  ToolTip.Tip="Open the release page; your package manager installs the update" />
          <Button Classes="flat" Content="Skip" Command="{Binding SkipCommand}" IsEnabled="{Binding CanAct}" ToolTip.Tip="Skip this version" />
          <Button Classes="flat" Command="{Binding DismissCommand}" IsEnabled="{Binding CanAct}" ToolTip.Tip="Remind me next time">
            <c:Icon Classes="icon" Data="{StaticResource IcoClose}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Player bar -->
    <Border Grid.Row="3" Classes="wideonly" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
      <!-- The right-hand buttons keep their size; title and transport share what is left -->
      <Grid ColumnDefinitions="*,2*,Auto" DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ShowNowPlayingAlbumCommand}">
            <Border Width="58" Height="58" CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface3}">
              <Panel>
                <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="24" Height="24" Stroke="{StaticResource Faint}" />
                <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="128" />
              </Panel>
            </Border>
          </Button>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="BarTitle" Classes.link="{Binding !IsFollowing}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" ToolTip.Tip="Go to album" ToolTip.ServiceEnabled="{Binding !IsFollowing}" />
            <TextBlock x:Name="BarArtist" Classes="muted small" Classes.link="{Binding !IsFollowing}" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" ToolTip.Tip="Go to artist" ToolTip.ServiceEnabled="{Binding !IsFollowing}" />
            <TextBlock Text="{Binding Album}" Classes="faint small" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="640">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" IsEnabled="{Binding !IsFollowing}">
            <Button Classes="flat" Classes.on="{Binding Shuffle}" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
              <c:Icon Classes="icon" Data="{StaticResource IcoShuffle}" />
            </Button>
            <Button Classes="flat" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous (Ctrl+Left)">
              <c:Icon Classes="icon fill" Data="{StaticResource IcoPrev}" />
            </Button>
            <Button Classes="play" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play/Pause (Space)">
              <Panel>
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPlay}" Width="20" Height="20" Margin="3,0,0,0" IsVisible="{Binding !IsPlaying}" />
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPause}" Width="18" Height="18" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <Button Classes="flat" Command="{Binding NextCommand}" ToolTip.Tip="Next (Ctrl+Right)">
              <c:Icon Classes="icon fill" Data="{StaticResource IcoNext}" />
            </Button>
            <Button Classes="flat" Classes.on="{Binding RepeatOn}" Command="{Binding CycleRepeatCommand}" ToolTip.Tip="Repeat: off / all / one">
              <Panel>
                <c:Icon Classes="icon" Data="{StaticResource IcoRepeat}" />
                <TextBlock Text="1" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding RepeatOne}" />
              </Panel>
            </Button>
          </StackPanel>
          <Grid ColumnDefinitions="44,*,44">
            <TextBlock Text="{Binding PositionText}" Classes="faint small" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="1" x:Name="SeekSlider" Classes="seek" Minimum="0" Maximum="{Binding Duration}"
                    Value="{Binding Position, Mode=OneWay}" IsEnabled="{Binding HasOwnTrack}" Margin="10,-8" />
            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="faint small" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
          <Button Classes="flat" ToolTip.Tip="Find metadata for this album" IsEnabled="{Binding HasOwnTrack}"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).MatchNowPlayingCommand}">
            <c:Icon Classes="icon" Data="{StaticResource IcoMagic}" />
          </Button>
          <Button Classes="flat" Classes.on="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).Vibe.InVibe}"
                  ToolTip.Tip="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).Vibe.ButtonTip}"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleVibeCommand}">
            <c:Icon Classes="icon" Data="{StaticResource IcoVibe}" />
          </Button>
          <Button Classes="flat" Classes.on="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).Lyrics.IsOpen}" ToolTip.Tip="Lyrics (L)"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleLyricsCommand}">
            <c:Icon Classes="icon" Data="{StaticResource IcoLyrics}" />
          </Button>
          <Button Classes="flat" Classes.on="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).NowPlayingOpen}" ToolTip.Tip="Now playing view (V)"
                  Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleNowPlayingCommand}">
            <c:Icon Classes="icon" Data="{StaticResource IcoWave}" />
          </Button>
          <Button Classes="flat" x:Name="MiniButton" ToolTip.Tip="Miniplayer (Ctrl+M)"
                  IsVisible="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).Capabilities.Miniplayer}">
            <c:Icon Classes="icon" Data="{StaticResource IcoMini}" />
          </Button>
          <!-- Scroll anywhere over the icon or slider to change the volume -->
          <StackPanel x:Name="VolumeArea" Orientation="Horizontal" Background="Transparent" Margin="4,0,0,0">
            <Button Classes="flat" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (scroll to change volume)">
              <Panel>
                <c:Icon Classes="icon" Data="{StaticResource IcoVolume}" IsVisible="{Binding !Muted}" />
                <c:Icon Classes="icon" Data="{StaticResource IcoVolumeMute}" IsVisible="{Binding Muted}" />
              </Panel>
            </Button>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="{Binding Volume}" Classes="seek" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Phone: the mini player; tap it for the full now-playing screen -->
    <Border Grid.Row="3" Classes="compactonly">
      <Border IsVisible="{Binding !SheetOpen}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,Auto" DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel">
          <ProgressBar Classes="thin" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="8,6,6,6">
            <Button Classes="row" Padding="4" Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).ToggleNowPlayingCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface3}">
                  <Panel>
                    <c:Icon Classes="icon" Data="{StaticResource IcoNote}" Width="20" Height="20" Stroke="{StaticResource Faint}" />
                    <c:CoverImage Path="{Binding CoverPath}" DecodeWidth="96" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Artist}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="flat" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding !IsFollowing}" Margin="4,0,0,0">
              <Panel>
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPlay}" Width="24" Height="24" IsVisible="{Binding !IsPlaying}" />
                <c:Icon Classes="icon fill" Data="{StaticResource IcoPause}" Width="22" Height="22" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <Button Grid.Column="2" Classes="flat" Command="{Binding NextCommand}" IsEnabled="{Binding !IsFollowing}">
              <c:Icon Classes="icon fill" Data="{StaticResource IcoNext}" Width="22" Height="22" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- Phone: the bottom bar -->
    <Border Grid.Row="4" Classes="compactonly">
      <Border IsVisible="{Binding !SheetOpen}" Background="{StaticResource Surface}">
        <Grid ColumnDefinitions="4*,*">
          <ItemsControl ItemsSource="{Binding PrimaryNav}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="tab" Classes.on="{Binding IsSelected}" CommandParameter="{Binding}"
                        Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).NavigateToCommand}">
                  <StackPanel Spacing="3">
                    <Border Classes="pill" HorizontalAlignment="Center">
                      <c:Icon Classes="icon" Data="{Binding Icon}" Width="20" Height="20" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="1" Classes="tab" Classes.on="{Binding MoreSelected}" Command="{Binding ShowMoreCommand}">
            <StackPanel Spacing="3">
              <Border Classes="pill" HorizontalAlignment="Center">
                <c:Icon Classes="icon" Data="{StaticResource IcoMore}" Width="20" Height="20" />
              </Border>
              <TextBlock Text="More" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Border>

    <!-- Toast -->
    <Border Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100"
            Background="{StaticResource Surface3}" CornerRadius="10" Padding="16,10" MaxWidth="560"
            IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" BoxShadow="0 6 24 0 #80000000">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
    </Border>
  </Grid>

  <UserControl.Styles>
    <!-- Wide (desktop) sizes; the phone layout below overrides them. -->
    <Style Selector="StackPanel#Brand"><Setter Property="Width" Value="196" /></Style>
    <Style Selector="Border#Sheet">
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="CornerRadius" Value="10,0,0,0" />
    </Style>
    <Style Selector="Border.sidepanel">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Width" Value="380" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Slider#VolumeSlider"><Setter Property="Width" Value="120" /></Style>
    <!-- Narrow windows: a slimmer lyrics panel and volume slider, so the page and player bar still fit. -->
    <Style Selector="v|MainView.narrow Border#LyricsPanel"><Setter Property="Width" Value="300" /></Style>
    <Style Selector="v|MainView.narrow Slider#VolumeSlider"><Setter Property="Width" Value="80" /></Style>

    <!-- Phone-sized: bottom bar and mini player instead of the sidebar and player bar; panels fill the screen. -->
    <Style Selector=":is(Control).compactonly"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="v|MainView.compact :is(Control).compactonly"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="v|MainView.compact :is(Control).wideonly"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="v|MainView.compact Border#Sidebar"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="v|MainView.compact StackPanel#Brand"><Setter Property="Width" Value="NaN" /></Style>
    <Style Selector="v|MainView.compact Border#Sheet">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="v|MainView.compact Border.sidepanel">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.play.big">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="ToggleButton.chip.icononly"><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="ProgressBar.thin">
      <Setter Property="Height" Value="2" />
      <Setter Property="MinHeight" Value="2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="TextBlock.lyric">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,7" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.25" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.lyric.past"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Style>
    <Style Selector="TextBlock.lyric.current"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
  </UserControl.Styles>
</UserControl>
