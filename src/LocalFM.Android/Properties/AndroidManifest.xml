<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Online metadata, lyrics and covers; vibes (TLS between phones and computers). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Vibes on the local network: receiving multicast announcements needs a multicast lock; a Wi-Fi lock keeps a
       vibe's connection up with the screen off. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- The phone's own music, read by path (Android 13+; older versions use the storage permission). -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- Playing in the background: a media playback foreground service with its notification, and the CPU kept
       awake while playing (the screen may be off). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:label="LocalFM" android:icon="@drawable/icon" android:allowBackup="false" />
</manifest>
