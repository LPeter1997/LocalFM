<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android app: AvaloniaMainActivity showing the shared MainView, a media playback service (notification,
       lock screen, audio focus) and the library from the phone's music folders. Not in LocalFM.slnx: building it
       needs the android workload (docs/android.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>LocalFM.Android</RootNamespace>
    <AssemblyName>LocalFM.Android</AssemblyName>
    <ApplicationId>io.github.lpeter1997.localfm</ApplicationId>
    <ApplicationTitle>LocalFM</ApplicationTitle>
    <!-- versionName is the release version; versionCode must grow with it: 1.2.3 → 10203. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Minor), 100)))), $([System.Version]::Parse($(Version)).Build)))</ApplicationVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- One APK for both ABIs (arm64 phones, x64 emulators). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- IL2104 only summarises another assembly's own trim warnings: here Avalonia.DesignerSupport and SQLitePCLRaw's
         Android bundle, which the desktop publish does not trim. Our code's IL warnings stay errors, and the trimmed
         Release APK is run on the emulator before a release (docs/android.md). -->
    <WarningsAsErrors>$(WarningsAsErrors.Replace('IL2104;', ''))</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- adb install works without the IDE's fast deployment. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LocalFM.UI.Shared\LocalFM.UI.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidResource Include="..\LocalFM.UI\Assets\icon.png" Link="Resources\drawable\icon.png" />
  </ItemGroup>
  <!-- localfm_native and FFmpeg (native/build.sh android-arm64|android-x64 <ffmpeg-prefix>). -->
  <ItemGroup>
    <AndroidNativeLibrary Include="$(NativeOutDir)android-arm64/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(NativeOutDir)android-x64/*.so" Abi="x86_64" />
  </ItemGroup>
  <!-- Licences travel with the app: LocalFM's own and the LGPL of the bundled FFmpeg (assets/licenses/). -->
  <ItemGroup>
    <AndroidAsset Include="$(RepoRoot)LICENSE" Link="Assets/licenses/LICENSE.txt" />
    <AndroidAsset Include="$(NativeOutDir)android-arm64/FFmpeg-COPYING.LGPLv2.1.txt" Link="Assets/licenses/FFmpeg-COPYING.LGPLv2.1.txt" />
  </ItemGroup>
  <Target Name="CheckNativeLibs" BeforeTargets="Build">
    <Error Condition="!Exists('$(NativeOutDir)android-arm64/liblocalfm_native.so') Or !Exists('$(NativeOutDir)android-x64/liblocalfm_native.so')"
           Text="Build the native libraries first: native/ffmpeg/build.sh and native/build.sh for android-arm64 and android-x64 (docs/android.md)." />
  </Target>
</Project>
