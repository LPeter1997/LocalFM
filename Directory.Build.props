<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible Condition="'$(IsTestProject)' != 'true'">true</IsAotCompatible>
    <!-- Trim/AOT warnings are bugs: a reflection surprise at runtime is worse than a build break. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2104;IL3050;IL3051;IL3053;nullable</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The release version; package.sh / package.ps1 pass -p:Version. -->
    <Version>0.1.0</Version>
    <!-- Linux app id: desktop file, metainfo, Flatpak, macOS bundle id, WM_CLASS and the MPRIS DesktopEntry. -->
    <LocalFMAppId>io.github.LPeter1997.LocalFM</LocalFMAppId>
    <!-- Line numbers in stack traces without loose .pdb files in the publish folder (packaged as is). -->
    <DebugType>embedded</DebugType>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <NativeOutDir>$(RepoRoot)native/out/</NativeOutDir>
  </PropertyGroup>
</Project>
