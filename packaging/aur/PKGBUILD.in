# Maintainer: Peter Lenkefi <lenkefi.peti at gmail dot com>
# AUR package from the release's distro tarball (built with -p:LocalFMUpdater=false: pacman updates it).
# package.sh fills in the version and checksums and writes the PKGBUILD next to the tarballs.
pkgname=localfm-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Play your own music, with everything there is to know about it'
arch=('x86_64' 'aarch64')
url='https://github.com/LPeter1997/LocalFM'
license=('MIT' 'LGPL-2.1-or-later')
depends=('fontconfig' 'libx11' 'libice' 'libsm' 'openssl' 'alsa-lib' 'icu')
optdepends=('libpulse: PulseAudio/PipeWire output' 'yt-dlp: importing from links')
provides=('localfm')
conflicts=('localfm')
options=('!strip' '!debug')
source_x86_64=("https://github.com/LPeter1997/LocalFM/releases/download/v${pkgver}/localfm-${pkgver}-linux-x64.tar.gz")
source_aarch64=("https://github.com/LPeter1997/LocalFM/releases/download/v${pkgver}/localfm-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  cd "localfm-${pkgver}"
  install -d "$pkgdir/usr/lib/localfm" "$pkgdir/usr/bin"
  cp -a lib/. "$pkgdir/usr/lib/localfm/"
  ln -s /usr/lib/localfm/LocalFM "$pkgdir/usr/bin/localfm"
  cp -a share/. "$pkgdir/usr/share/"
}
